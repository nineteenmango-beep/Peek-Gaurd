<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="peekguard_database"/>
        <exclude domain="sharedpref" path="sensitive_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="user_preferences.xml"/>
        <exclude domain="database" path="detection_events"/>
    </device-transfer>
</data-extraction-rules>